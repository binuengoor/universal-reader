# Universal Reader Environment Configuration

# URL to the upstream OpenAI-compatible Universal Speech gateway
TTS_BASE_URL=http://host.docker.internal:8000

# API key for the speech gateway (its SPEECH_API_KEY)
TTS_API_KEY=

# HTTP Basic auth for the whole app (UI, API, audio). Leave the password empty
# only if the app sits behind an authenticating reverse proxy.
READER_USERNAME=reader
READER_PASSWORD=

# Allow importing URLs that resolve to private/LAN addresses (off by default to prevent SSRF)
ALLOW_PRIVATE_URLS=

# Maximum upload size for PDF/EPUB/DOCX/text imports
MAX_UPLOAD_MB=50

# Extra origins allowed to call the API cross-origin (comma-separated); not needed
# when the UI is served by this backend or through the Vite dev proxy.
CORS_ORIGINS=

# Storage directory (defaults to /data/documents inside Docker)
DATA_DIR=/data/documents
